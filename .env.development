# =============================================================================
# Configuração de DESENVOLVIMENTO (versionada): só placeholders, nunca segredo real.
#   cp .env.development .env   e troque cada CHANGE_ME / chave vazia no .env.
# Referência completa das variáveis: .env.example. Teste: tests/unit/test_env_files.py
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_TITLE=Orquestrador IA - Desenvolvimento
APP_HOST=127.0.0.1
APP_PORT=7777
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# --- MongoDB -----------------------------------------------------------------
# App no host falando com o Mongo do docker-compose.dev.yml (porta só no loopback).
# App no container: o docker-compose.dev.yml monta a connection string sozinho.
MONGO_CONNECTION_STRING=mongodb://CHANGE_ME:CHANGE_ME@localhost:27017/agno?authSource=admin
MONGO_DATABASE_NAME=agno
USE_TLS=false
TLS_ALLOW_INVALID_CERTIFICATES=false

# --- Modelos -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Preencha só os providers que for usar (vazio = provider indisponível).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_VERSION=

# --- OpenTelemetry -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=orquestrador-ia

# --- docker-compose.dev.yml --------------------------------------------------
# Usuário/senha do Mongo entram numa URL mongodb://: use valores URL-safe.
MONGO_ROOT_USERNAME=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_EXPRESS_USERNAME=CHANGE_ME
MONGO_EXPRESS_PASSWORD=CHANGE_ME

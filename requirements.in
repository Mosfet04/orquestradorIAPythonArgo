# === AG-UI Protocol (interface AGUI para os.agno.com) ===
ag-ui-protocol>=0.1.13,<0.2  # 1.0 é major nova; agno.os.interfaces.agui 2.5.8 usa a 0.1.x

# === Compatibilidade com Python 3.11 (Dockerfile python:3.11 e CI) ===
# O lock é gerado em 3.12; numpy >= 2.5 exige Python >= 3.12 (transitivo de
# chromadb/onnxruntime). Remover quando o projeto abandonar o 3.11.
numpy<2.5

# === Portabilidade do lock (Windows) ===
# click, tqdm e uvicorn[standard] exigem colorama SÓ no Windows. O pip-compile roda
# no Linux e descarta requisitos com marker falso, então o lock ficaria sem colorama
# e `pip install --require-hashes` falharia no Windows. Sem marker de propósito;
# no Linux o pacote é inerte (structlog/click/tqdm só o usam quando os.name == "nt").
colorama>=0.4.6

# === Extras opcionais (NÃO instalados por padrão, fora do lock) ===
# Só são necessários para os providers/recursos correspondentes:
#   PyJWT      -> autenticação JWT do AgentOS (agno[os])
#   mcp        -> tools MCP (agno[mcp])
#   anthropic  -> provider "anthropic" (agno[anthropic])
#   groq       -> provider "groq" (agno[groq])
# Para adotar um deles: acrescente aqui com versão mínima e regenere o lock.

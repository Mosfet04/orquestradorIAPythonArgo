# Dependências diretas de runtime (fonte de verdade).
# O lock reprodutível com hashes é gerado a partir deste arquivo. Nunca edite
# requirements.lock à mão. Atualizar (tudo, ou um pacote com --upgrade-package X):
#   .venv/bin/pip-compile --upgrade --generate-hashes --allow-unsafe --strip-extras \
#       --output-file=requirements.lock requirements.in
#   .venv/bin/pip-audit -r requirements.lock --require-hashes --disable-pip
# Depois regenere requirements-dev.lock (ele usa -c requirements.lock).
# Detalhes: "Dependencies and lock files" no CONTRIBUTING.md.

# Tetos de major (<N) abaixo: SDKs consumidos pelo agno ficam na major com que o
# agno 2.5.8 foi validado; subir major é trabalho da migração do agno (F3), não de
# um --upgrade. Nenhum desses tetos segura correção de CVE (ver pip-audit).

# === Core AI Framework ===
# Versão exata: toda a evidência do roadmap (docs/roadmap/) é da 2.5.8.
agno==2.5.8

# === Web Framework ===
# Teto <0.137: a partir da 0.137 o include_router embrulha as rotas em _IncludedRouter
# (sem .path) e o agno 2.5.8 assume lista plana de APIRoute: AgentOS.resync() quebra
# com AttributeError (agno/os/app.py:425-429) e a detecção de conflito de rotas
# (agno/os/utils.py:707-748, usada por on_route_conflict) deixa de ver rotas incluídas.
fastapi>=0.115.0,<0.137
uvicorn>=0.34.0
python-dotenv>=1.0.0
# Starlette é importada diretamente (src/infrastructure/web/).
starlette>=1.3.1  # piso = primeira versão sem os CVEs PYSEC-2026-248/249/2280/2281
# uvloop não existe para Windows. ATENÇÃO: app.py ainda importa uvloop sem guarda,
# então no Windows o app.py falha até o F1-03 corrigir esse import.
uvloop>=0.21.0; sys_platform != "win32"

# === Database ===
motor>=3.7.0
pymongo>=4.13.0


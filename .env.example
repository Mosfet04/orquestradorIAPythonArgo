# =============================================================================
# Modelo de configuração. Copie para .env (nunca versionado) e ajuste:
#   cp .env.example .env
# Lista exatamente as variáveis que o projeto lê (código, agno e arquivos docker-compose).
# Segredos: deixe vazio aqui e preencha só no .env. Teste: tests/unit/test_env_files.py
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_TITLE=Orquestrador IA
# Fora do container o default é 127.0.0.1 (só loopback). A imagem Docker usa 0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=7777
LOG_LEVEL=INFO
# development | test | staging | production (outro valor impede o app de iniciar).
# production troca o formato do log para JSON. Ausente: development no host,
# production na imagem Docker (development com o docker-compose.dev.yml). Uma linha
# ativa aqui é repassada pelo compose e vence o default da imagem.
# ENVIRONMENT=development
# /docs, /redoc e /openapi.json. Vazio = ligado só em ENVIRONMENT=development.
ENABLE_DOCS=
# Origens do CORS separadas por vírgula ("*" não é aceito). Vazio = default:
# https://app.agno.com,https://www.agno.com,http://localhost:3000,http://localhost:7777,https://os.agno.com
CORS_ALLOWED_ORIGINS=
# Autenticação da borda (Authorization: Bearer <chave> ou X-API-Key: <chave>).
# API_KEY_RUN: uso dos agentes/teams (runs, AG-UI, sessões...). API_KEY_ADMIN: tudo
# que a run acessa mais /admin/*, /metrics*, migrações, exclusões e escrita em knowledge.
# As duas juntas, diferentes entre si, com ao menos 32 caracteres ASCII visíveis. Gere:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem nenhuma, o app só inicia com APP_HOST em loopback e ENVIRONMENT development/test
# (sem chave, com aviso no log, e só para request local: cliente, servidor e Host em
# loopback, Origin ausente ou em CORS_ALLOWED_ORIGINS; proxy/túnel no próprio host
# ainda expõe); fora disso recusa iniciar. O
# docker-compose.yml exige as duas (o container faz bind em 0.0.0.0).
API_KEY_RUN=
API_KEY_ADMIN=
# Telemetria do Agno (envio de uso para a Agno). O app assume false se ausente.
AGNO_TELEMETRY=false
# Metadados de log/trace. HOSTNAME normalmente vem do SO/container.
# HOSTNAME=
# AWS_REGION=

# --- MongoDB -----------------------------------------------------------------
MONGO_CONNECTION_STRING=mongodb://localhost:62659/?directConnection=true
MONGO_DATABASE_NAME=agno
# TLS é ligado automaticamente para *.mongodb.net; USE_TLS força para outros hosts.
USE_TLS=false
# Só para desenvolvimento: aceita certificado/hostname inválido quando TLS está ligado.
TLS_ALLOW_INVALID_CERTIFICATES=false

# --- Config de agentes, teams e tools ----------------------------------------
# De onde vêm agentes, teams e tools: mongo (coleções agents_config, teams_config e tools) ou
# yaml (arquivo em CONFIG_YAML_PATH; modelo em config.example.yaml). Vazio = mongo; outro valor
# impede o app de iniciar. Com yaml o MongoDB continua obrigatório (sessões, memória, RAG).
# CONFIG_STORE=mongo
# Obrigatória com CONFIG_STORE=yaml: arquivo regular legível (relativo = a partir do diretório
# de trabalho). Consultado no startup e no POST /admin/refresh-cache (relido só se mudou), sem
# recarga automática. Âncoras/aliases (& e *) e chave repetida são recusados.
# No container (raiz somente leitura), monte o arquivo como volume :ro.
# CONFIG_YAML_PATH=config.example.yaml

# --- Modelos -----------------------------------------------------------------
# Servidor Ollama usado pelos modelos e embedders "ollama". Vazio = defaults do cliente
# ollama/agno: variável OLLAMA_HOST, senão http://localhost:11434; com só a
# OLLAMA_API_KEY preenchida, o agno usa o Ollama Cloud (https://ollama.com).
OLLAMA_BASE_URL=
# Chaves por provider (sem api_key_ref no documento): o registry de providers lê
# <PROVIDER>_API_KEY, onde PROVIDER é o factory_ia_model do agente em maiúsculas
# (aliases: google -> GEMINI, azureopenai -> AZURE). OLLAMA_API_KEY é lida pelo próprio
# agno (só para Ollama Cloud). O provider openai_compatible não lê chave do ambiente:
# só a do api_key_ref do documento.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
# Azure OpenAI (provider "azure"): AZURE_API_KEY + AZURE_ENDPOINT (+ AZURE_VERSION).
AZURE_API_KEY=
# AZURE_ENDPOINT=https://<recurso>.openai.azure.com
# AZURE_VERSION=
# Raiz dos segredos por arquivo (api_key_ref "file:/caminho" nos documentos de config):
# arquivo fora dela (inclusive via symlink) é recusado. Vazio = /run/secrets; relativo ou "/"
# impede o app de iniciar. (api_key_ref "env:" só aceita variáveis <PROVEDOR>_API_KEY.)
# SECRETS_DIR=
# Hosts aceitos em base_url de modelo/embedder vinda dos documentos de config, separados por
# vírgula: só o host (ex.: llm.interno.example,10.0.0.5), sem esquema, porta, caminho nem "*".
# Sem base_url no documento, nada muda. Fora desta lista, base_url só é aceita no host do
# próprio provider (ex.: api.openai.com, sempre com https, mesmo se listado aqui) ou, no
# modo dev local (sem API_KEY_*, APP_HOST em loopback, ENVIRONMENT development/test), em
# loopback. Metadata de nuvem e link-local (169.254.0.0/16, fe80::/10...) são sempre
# recusados. Vazio = nenhum host extra.
# A lista vale para todos os providers (o documento escolhe provider e api_key_ref): liste só
# hosts confiáveis para receber as chaves de provider do processo. O provider azure não aceita
# base_url do documento: o endpoint vem só de AZURE_ENDPOINT.
MODEL_BASE_URL_ALLOWLIST=
# Plugins de provider (pacotes instalados que declaram um entry point no grupo
# orquestrador.providers; exemplo em examples/provider_plugin). Só carrega os listados aqui,
# como distribuição:nome separados por vírgula (ex.: orquestrador-provider-deepseek:deepseek);
# o nome da distribuição é comparado sem caixa e com "-", "_" e "." equivalentes (PEP 503).
# Plugin instalado fora da lista nunca é importado (fica um warning no log). Entrada sem plugin
# instalado, plugin que falha ao carregar ou que repete id/alias de provider (de um built-in ou
# de outro plugin) impedem o app de iniciar. Vazio = nenhum plugin.
PLUGIN_ALLOWLIST=
# Só para desenvolver um plugin sem empacotar: specs por módulo:atributo (ex.: meu_provider:SPEC),
# separadas por vírgula. Valem só com ALLOW_DYNAMIC_IMPORT=true no modo dev local (sem API_KEY_*,
# APP_HOST em loopback, ENVIRONMENT development/test); definidas fora disso, o app não inicia.
# ALLOW_DYNAMIC_IMPORT=false
# DYNAMIC_PROVIDER_SPECS=

# --- OpenTelemetry / Observabilidade (Grafana LGTM) ---------------------------
# App no host: http://localhost:4317. App no compose: default http://grafana-lgtm:4317
# (o Grafana LGTM não faz parte deste compose; aponte para o seu coletor).
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=orquestrador-ia

# --- docker compose -------------------------------------------------------------
# docker-compose.yml (só o app) exige MONGO_CONNECTION_STRING, API_KEY_RUN e API_KEY_ADMIN.
# docker-compose.dev.yml (MongoDB/Ollama/mongo-express locais) exige as quatro abaixo
# E TAMBÉM as três do docker-compose.yml (o arquivo base continua exigindo, mesmo que o
# override monte sozinho a connection string e o OLLAMA_BASE_URL do app no container).
# As demais variáveis desta lista (chaves de provider, ENVIRONMENT, TLS...) são
# repassadas ao container do app; APP_HOST/APP_PORT ficam com o Dockerfile.
# ATENÇÃO: MONGO_ROOT_USERNAME/MONGO_ROOT_PASSWORD entram numa URL mongodb://
# (app e mongo-express): use valores URL-safe (letras, dígitos, "-", "_", "."), sem
# @ : / ? # % nem espaço.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=
